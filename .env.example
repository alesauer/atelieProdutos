# Configuração do MySQL
MYSQL_ROOT_PASSWORD=sua_senha_root_mysql_segura
MYSQL_DATABASE=casaluma_estoque
MYSQL_USER=casaluma_user
MYSQL_PASSWORD=sua_senha_usuario_mysql_segura

# Portas públicas expostas pelo Docker Compose
FRONTEND_PORT=80
BACKEND_PORT=8000

# Backend e Segurança
SECRET_KEY=altere_esta_chave_secreta_com_pelo_menos_32_caracteres_aleatorios_em_producao
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Mídias
MAX_IMAGE_SIZE_MB=3
MAX_IMAGES_PER_PRODUCT=5

# E-mail
EMAIL_DRIVER=log
EMAIL_FROM=estoque@casaluma.com.br
EMAIL_API_KEY=
