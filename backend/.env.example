# Configurações do Banco de Dados MySQL
DATABASE_URL=mysql+pymysql://casaluma_user:casaluma_password@db:3306/casaluma_estoque?charset=utf8mb4

# Segurança e JWT
SECRET_KEY=altere_esta_chave_secreta_com_pelo_menos_32_caracteres_aleatorios_em_producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Armazenamento e Limites de Mídias
MEDIA_DIR=/app/media
MAX_IMAGE_SIZE_MB=15
MAX_IMAGES_PER_PRODUCT=10

# CORS - Origens permitidas (JSON Array)
CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:5173", "http://127.0.0.1:5173"]

# Notificações e Alertas por E-mail
# Drivers suportados: log (padrão de desenvolvimento), stub, resend, sendgrid, smtp
EMAIL_DRIVER=log
EMAIL_FROM=estoque@casaluma.com.br
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
